# Database connection string for Prisma
# Use a PostgreSQL database (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/zuyiba?schema=public"

# Direct database URL for Prisma migrations (some providers require this)
# Use the same value as DATABASE_URL for local development
DIRECT_URL="postgresql://user:password@localhost:5432/zuyiba?schema=public"

# football-data.org API key for fetching player data
# Get your free API key at: https://www.football-data.org/client/register
# Only needed when running: npm run fetch-players
FOOTBALL_DATA_API_KEY=""
